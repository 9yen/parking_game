; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="一起停车吧"
config/description="A cozy desktop idle parking game."
config/version="0.3.0-demo"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=10000
run/max_fps=30

[display]

window/size/viewport_width=1120
window/size/viewport_height=720
window/size/window_width_override=1120
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
